---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  meta?: string;
}
const {
  title = '论文速递',
  description = '每日个性化 arxiv 论文筛选与推送',
  meta,
} = Astro.props;

const fullTitle = title === '论文速递' ? title : `${title} · 论文速递`;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="zh">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5efde" />
    <script is:inline>
      (() => {
        const themeColors = {
          paper: '#f5efde',
          mist: '#f3f6f5',
          night: '#171918',
          mono: '#fafafa',
        };
        try {
          const state = JSON.parse(sessionStorage.getItem('paper-brief-theme') || '{}');
          if (state.theme && themeColors[state.theme]) {
            document.documentElement.dataset.theme = state.theme;
            document.querySelector('meta[name="theme-color"]')?.setAttribute(
              'content',
              themeColors[state.theme],
            );
          }
          if (state.accent && state.accent !== 'default') {
            document.documentElement.dataset.accent = state.accent;
          }
        } catch {}
      })();
    </script>
    <title>{fullTitle}</title>

    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
  </head>
  <body>
    <header class="topbar">
      <a class="brand" href={`${base}/`}>论文速递</a>
      <div class="topbar-tools">
        <span class="meta">{meta ?? 'paper · brief'}</span>
        <div class="theme-picker" data-theme-picker>
          <button
            class="theme-toggle"
            type="button"
            aria-label="调整网站配色"
            aria-expanded="false"
            aria-controls="theme-panel"
            title="调整配色"
            data-theme-toggle
          >
            <span aria-hidden="true">◐</span>
          </button>

          <div class="theme-panel" id="theme-panel" data-theme-panel hidden>
            <div class="theme-panel-head">
              <span>配色</span>
              <button
                class="theme-reset"
                type="button"
                aria-label="恢复默认配色"
                title="恢复默认"
                data-theme-reset
              >
                <span aria-hidden="true">↺</span>
              </button>
            </div>

            <div class="theme-options" role="radiogroup" aria-label="整体主题">
              <button type="button" role="radio" aria-checked="true" data-theme-option="paper">
                <span class="theme-preview preview-paper" aria-hidden="true"></span>
                <span>纸张</span>
              </button>
              <button type="button" role="radio" aria-checked="false" data-theme-option="mist">
                <span class="theme-preview preview-mist" aria-hidden="true"></span>
                <span>雾白</span>
              </button>
              <button type="button" role="radio" aria-checked="false" data-theme-option="night">
                <span class="theme-preview preview-night" aria-hidden="true"></span>
                <span>夜读</span>
              </button>
              <button type="button" role="radio" aria-checked="false" data-theme-option="mono">
                <span class="theme-preview preview-mono" aria-hidden="true"></span>
                <span>黑白</span>
              </button>
            </div>

            <div class="accent-options" role="radiogroup" aria-label="强调色">
              <button type="button" role="radio" aria-checked="true" data-accent-option="default" aria-label="主题默认强调色"></button>
              <button type="button" role="radio" aria-checked="false" data-accent-option="rust" aria-label="锈红强调色"></button>
              <button type="button" role="radio" aria-checked="false" data-accent-option="teal" aria-label="青绿强调色"></button>
              <button type="button" role="radio" aria-checked="false" data-accent-option="blue" aria-label="蓝色强调色"></button>
              <button type="button" role="radio" aria-checked="false" data-accent-option="green" aria-label="绿色强调色"></button>
              <button type="button" role="radio" aria-checked="false" data-accent-option="magenta" aria-label="洋红强调色"></button>
            </div>
          </div>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-foot">
      <span>paper-brief · {new Date().getUTCFullYear()}</span>
    </footer>

    <script>
      import { initThemePicker } from '../scripts/theme';
      initThemePicker();
    </script>
  </body>
</html>
